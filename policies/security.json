{
  "schema_version": 2,
  "path_allow_patterns": ["(^|/)\\.env\\.(?:example|sample|template|variables)$"],
  "forbidden_path_patterns": [
    "(^|/)\\.env$",
    "(^|/)\\.env\\.(?:local|production|prod|staging|stage|development|dev)$",
    "(^|/)(?:id_rsa|id_ed25519)$",
    "\\.(?:pem|p12|pfx|key)$",
    "(^|/)(?:credentials?|secrets?)\\.json$"
  ],
  "secret_patterns": [
    {
      "name": "private-key",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
    },
    {
      "name": "github-token",
      "pattern": "(?:github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,})"
    },
    {
      "name": "aws-access-key",
      "pattern": "(?:AKIA|ASIA)[0-9A-Z]{16}"
    },
    {
      "name": "google-api-key",
      "pattern": "AIza[0-9A-Za-z_-]{35}"
    },
    {
      "name": "slack-token",
      "pattern": "xox[baprs]-[A-Za-z0-9-]{20,}"
    },
    {
      "name": "stripe-live-key",
      "pattern": "(?:sk|rk)_live_[A-Za-z0-9]{16,}"
    },
    {
      "name": "openai-anthropic-key",
      "pattern": "\\bsk-(?:ant-[A-Za-z0-9_-]{20,}|(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{32,})"
    },
    {
      "name": "nvidia-api-key",
      "pattern": "\\bnvapi-[A-Za-z0-9_-]{20,}"
    },
    {
      "name": "huggingface-token",
      "pattern": "\\bhf_[A-Za-z0-9]{30,}"
    },
    {
      "name": "tailscale-auth-key",
      "pattern": "\\btskey-[A-Za-z0-9-]{20,}"
    },
    {
      "name": "cloudflare-api-token",
      "pattern": "CLOUDFLARE_API_TOKEN\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{30,}"
    },
    {
      "name": "jwt",
      "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    }
  ],
  "secret_allowlist": [
    {
      "path": "^tests/packs/internal-vault/unit/test_preflight\\.py$",
      "pattern": "sk-[p]roj-aB3dE5fG7hI9jK1lM3nO5pQ7",
      "reason": "Synthetic API key used to test that the internal-vault preflight masks secrets; the only match of any secret pattern in the history of the seven repositories that is not a real finding."
    }
  ],
  "workflow_forbidden_patterns": [
    {
      "name": "serialize-secrets",
      "pattern": "toJSON\\s*\\(\\s*secrets\\s*\\)"
    },
    {
      "name": "pull-request-target",
      "pattern": "^\\s*pull_request_target\\s*:"
    },
    {
      "name": "write-all",
      "pattern": "^\\s*permissions\\s*:\\s*write-all\\s*$"
    },
    {
      "name": "expression-as-shell-argument",
      "pattern": "^\\s*\"?\\$\\{\\{\\s*(?:needs|steps|inputs|github\\.event)\\."
    }
  ],
  "require_pinned_actions": true,
  "path_terms": ["secret", "token", "auth", "permission", "credential"],
  "approved_workflows": [
    {
      "path": ".github/workflows/dispatch-pr-governance.yml",
      "sha256": "3128db3d54dcbafe4634d0140a3181e34ff0f0f5141be1af8c0111979d4d8fde"
    }
  ]
}
