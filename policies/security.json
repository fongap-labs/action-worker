    },
    {
      "name": "unix-home-path",
      "pattern": "/(?:home|Users)/[A-Za-z0-9._-]+(?:/[^\\s\"'<>]*)?"
    },
    {
      "name": "windows-home-path",
      "pattern": "[A-Za-z]:\\\\(?:Users|Documents and Settings)\\\\[^\\s\"'<>]+"
    },
    {
      "name": "local-file-uri",
      "pattern": "file:///(?:[A-Za-z]:/|home/|Users/)[^\\s\"'<>]+"
    }
  ],
