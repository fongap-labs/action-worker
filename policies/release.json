  "impact_patterns": {
    "breaking": ["breaking"],
    "security": ["security"],
    "migration": ["migration"],
    "api": ["api"],
    "deployment": ["deploy", "deployment"],
    "performance": ["performance"],
    "compatibility": ["compatible", "compatibility"],
    "release": ["release"]
  },
  "changelog_summary_max_characters": 140,
