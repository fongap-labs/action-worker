{
  "schema_version": 2,
  "changelog_file": "CHANGELOG.md",
  "change_types": [
    "feat",
    "fix",
    "docs",
    "style",
    "refactor",
    "perf",
    "test",
    "build",
    "ci",
    "chore",
    "revert"
  ],
  "change_attributes": ["breaking", "security", "migration"],
  "changelog_required_types": ["feat", "fix", "perf", "revert"],
  "impact_patterns": {
    "breaking": ["breaking"],
    "security": ["security"],
    "migration": ["migration"],
    "api": ["api"],
    "deployment": ["deploy", "deployment"],
    "performance": ["performance"],
    "compatibility": ["compatible", "compatibility"],
    "release": ["release"]
  }
}
