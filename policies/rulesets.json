{
  "schema_version": 1,
  "rulesets": [
    {
      "name": "Protect Main Branch",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": ["refs/heads/main"]
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "required_linear_history"
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "validate-merge"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Protect Legacy Branches",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": ["refs/heads/legacy/**"]
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "update"
        }
      ]
    }
  ]
}
