{
  "schema_version": 1,
  "review_types": [
    "source",
    "workflow",
    "script",
    "container",
    "security",
    "release"
  ],
  "agents": {
    "security": {
      "model": "Code-Ultra",
      "effort": "high",
      "rule": "security.json",
      "availability": "required"
    },
    "architecture": {
      "model": "Code-Ultra",
      "effort": "high",
      "rule": "architecture.json",
      "availability": "required"
    },
    "workflow": {
      "model": "Code-Pro",
      "effort": "low",
      "rule": "workflow.json",
      "availability": "best_effort"
    },
    "release": {
      "model": "Code-Pro",
      "effort": "low",
      "rule": "release.json",
      "availability": "best_effort"
    },
    "code": {
      "model": "Code-Pro",
      "effort": "medium",
      "rule": "code.json",
      "availability": "best_effort"
    }
  },
  "runtime": {
    "llm_timeout_seconds": 300,
    "task_timeout_minutes": 2,
    "concurrency": 1,
    "queue_poll_seconds": 15,
    "queue_wait_minutes": 120,
    "resume_attempts": 3,
    "resume_backoff_seconds": 15
  },
  "engine": {
    "name": "open-code-review",
    "version": "1.12.9",
    "asset": "open-code-review-linux-amd64",
    "repository": "fongap-labs/external-vault"
  }
}
