{
  "schema_version": 1,
  "control": {
    "execute_pr_code": false,
    "allow_secrets": true
  },
  "sandbox": {
    "execute_pr_code": true,
    "allow_secrets": false
  },
  "ci": {
    "workflow": "ci.yml",
    "poll_seconds": 15,
    "timeout_minutes": 180,
    "required_change_areas": [
      "source",
      "workflow",
      "script",
      "test",
      "container",
      "release",
      "security"
    ],
    "required_impacts": [
      "breaking",
      "security",
      "migration",
      "api",
      "deployment",
      "performance",
      "compatibility",
      "release"
    ],
    "gate_jobs": [
      "ci-evidence",
      "validate-merge"
    ],
    "central_repositories": [
      "fongap-labs/ai-gateway",
      "fongap-labs/delta",
      "fongap-labs/delta-suite",
      "fongap-labs/app-source",
      "fongap-labs/internal-vault",
      "fongap-labs/external-vault"
    ],
    "status_context": "CI Evidence"
  }
}
