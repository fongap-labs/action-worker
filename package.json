{
  "name": "@fongap-labs/action-worker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "ingress:staging-config": "node scripts/build-direct-ingress-staging-config.ts",
    "preflight": "node scripts/local-preflight.ts",
    "preflight:business": "node scripts/business-preflight.ts",
    "test": "node --test \"tests/*.test.ts\" \"tests/kit/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --max-diagnostics=100"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "imports": {
    "#kit/*": "./tests/kit/*"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  }
}
