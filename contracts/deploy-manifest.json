{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fongap-labs/action-worker/contracts/deploy-manifest.json",
  "title": "Deploy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "automatic",
    "ignore_docs_only",
    "runner_profile",
    "environment",
    "entrypoint"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "adapter": {
      "enum": ["cloudflare-worker", "source-script"]
    },
    "automatic": { "type": "boolean" },
    "ignore_docs_only": { "type": "boolean" },
    "runner_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "adapter": { "const": "source-script" } },
        "required": ["adapter"]
      },
      "then": {
        "properties": {
          "entrypoint": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "adapter": { "const": "cloudflare-worker" } },
        "required": ["adapter"]
      },
      "then": {
        "properties": { "entrypoint": { "const": "" } }
      }
    }
  ]
}
