{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "repository", "pr_number"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    }
  }
}
