{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fongap/action-worker/contracts/release-provenance.json",
  "title": "Release Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_sha",
    "artifact_repository",
    "artifact_run_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "artifact_run_id": {
      "type": "integer",
      "minimum": 1
    }
  }
}
