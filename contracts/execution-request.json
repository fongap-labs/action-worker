{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fongap-labs/action-worker/contracts/execution-request.json",
  "title": "Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "repository",
    "source_sha",
    "operation"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "operation": {
      "enum": [
        "ci",
        "review",
        "build",
        "release",
        "deploy",
        "task",
        "scheduled"
      ]
    }
  }
}
