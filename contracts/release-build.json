{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fongap-labs/action-worker/contracts/release-build.json",
  "title": "Release Build Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_name",
    "target_repository",
    "release_key",
    "release_name",
    "release_notes",
    "license_expression",
    "node_version_file",
    "python_version_file",
    "sbom_asset",
    "builds"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "root": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)?$",
      "description": "Repository-relative build root; the empty string or an omitted root is the repository root. A product under projects/ must declare a non-empty root."
    },
    "artifact_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "target_repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "release_key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "release_name": { "type": "string", "minLength": 1 },
    "release_notes": { "type": "string" },
    "license_expression": { "type": "string", "minLength": 1 },
    "node_version_file": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)?$"
    },
    "python_version_file": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)?$"
    },
    "sbom_asset": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "builds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runner_profile", "target", "script", "assets", "attest_asset"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "runner_profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "script": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?:(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)?[A-Za-z0-9._-]+\\.ps1$"
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
          },
          "attest_asset": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    }
  }
}
