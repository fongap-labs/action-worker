{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fongap-labs/action-worker/contracts/task-source.json",
  "title": "Task Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedules"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "schedules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cron",
          "projects"
        ],
        "properties": {
          "cron": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9*/,?\\- ]+$"
          },
          "projects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      }
    },
    "push": {
      "type": "boolean"
    }
  }
}
